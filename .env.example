# Backend Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/taxzy-ai
MONGODB_TEST_URI=mongodb://localhost:27017/taxzy-ai-test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Document Processor Service
DOCUMENT_PROCESSOR_URL=http://localhost:8000

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-if-using-openai
HUGGINGFACE_API_KEY=your-huggingface-api-key
LLM_MODEL=llama-3.1-8b-instruct
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Chroma Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=california-tax-documents

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# AWS/Azure Configuration (for production)
AWS_REGION=us-west-1
AWS_S3_BUCKET=taxzy-ai-documents
AZURE_STORAGE_CONNECTION_STRING=

# Redis (optional, for session management)
REDIS_URL=redis://localhost:6379
